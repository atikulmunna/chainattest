{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainattest.local/schemas/eval_claim.schema.json",
  "title": "EvalClaimManifest",
  "description": "Private evaluator manifest. The batch counts never leave it in plaintext: the relay package carries only the Poseidon transcript and score commitments built from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_id",
    "benchmark_digest",
    "dataset_split_digest",
    "inference_config_digest",
    "randomness_seed_digest",
    "transcript_version",
    "batch_correct_counts",
    "batch_incorrect_counts",
    "batch_abstain_counts",
    "threshold_bps",
    "min_sample_count",
    "evaluator",
    "evaluator_key_id",
    "evaluator_policy_digest",
    "evaluator_policy_version"
  ],
  "properties": {
    "attestation_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "benchmark_digest": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "dataset_split_digest": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "inference_config_digest": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "randomness_seed_digest": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "transcript_version": {
      "type": "integer",
      "minimum": 1
    },
    "batch_correct_counts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "batch_incorrect_counts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "batch_abstain_counts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "threshold_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "min_sample_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "evaluator": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "evaluator_key_id": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "evaluator_policy_digest": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "evaluator_policy_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
